# консоль: UART + экран
stdin=serial
stdout=serial,vidconsole
stderr=serial,vidconsole

# серийник для fastboot (иначе ????????)
serial#=dizi12345678

# bring-up: сразу в fastboot, чтобы можно было снять лог
bootdelay=0
preboot=reset
fastboot=fastboot -l $fastboot_addr_r usb 0

# меню (когда закомментируешь preboot выше)
bootmenu_0=Fastboot (USB)=run fastboot
bootmenu_1=Console info=coninfo
bootmenu_2=Reset device=reset
menucmd=bootmenu
