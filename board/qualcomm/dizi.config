# Xiaomi Redmi Pad Pro (dizi), SM7435 parrot.
# Применять поверх qcom_defconfig + qcom-phone.config:
#   make O=.output qcom_defconfig qcom-phone.config dizi.config

CONFIG_DEFAULT_DEVICE_TREE="qcom/dizi"
CONFIG_SYS_BOARD="dizi"
CONFIG_SYS_VENDOR="xiaomi"
CONFIG_SYS_CONFIG_NAME="dizi"
CONFIG_TEXT_BASE=0x80000000
CONFIG_SYS_LOAD_ADDR=0x80000000

# наш env (serial#, stdout=serial,vidconsole)
CONFIG_ENV_USE_DEFAULT_ENV_TEXT_FILE=y
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/xiaomi/dizi/dizi.env"

# early UART, адрес сверен с ABL DTB
CONFIG_DEBUG_UART=y
CONFIG_DEBUG_UART_ANNOUNCE=y
CONFIG_DEBUG_UART_MSM_GENI=y
CONFIG_DEBUG_UART_BASE=0x98c000
CONFIG_DEBUG_UART_CLOCK=7372800

# хранилища у нас нет (UFS не поддерживается fastboot'ом U-Boot) — не рискуем
# CONFIG_UFS is not set
# CONFIG_SCSI is not set
# CONFIG_MMC is not set
# CONFIG_FASTBOOT_FLASH is not set

CONFIG_BOARD_EARLY_INIT_F=y
# CONFIG_PANIC_HANG is not set
