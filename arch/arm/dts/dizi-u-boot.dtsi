/ {
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		framebuffer_reserved: framebuffer@9d400000 {
			reg = <0x0 0x9d400000 0x0 0x1000000>; /* 16MB */
			no-map;
		};
	};

	simple-framebuffer {
		compatible = "simple-framebuffer";
		memory-region = <&framebuffer_reserved>;
		width = <1600>;
		height = <2560>;
		stride = <(1600 * 4)>; /* 1600 пикселей * 4 байта (ARGB8888) */
		format = "a8r8g8b8";
	};
};
