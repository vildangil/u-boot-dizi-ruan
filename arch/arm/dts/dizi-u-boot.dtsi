/ {
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		framebuffer_reserved: framebuffer@a0000000 {
			reg = <0x0 0xa0000000 0x0 0x1000000>; /* 16MB на адресе A0000000 */
			no-map;
		};
	};

	simple-framebuffer {
		compatible = "simple-framebuffer";
		memory-region = <&framebuffer_reserved>;
		width = <1600>;
		height = <2560>;
		stride = <(1600 * 4)>;
		format = "a8r8g8b8";
	};
};

&usb_1_dwc3 {
	dr_mode = "peripheral";
};
