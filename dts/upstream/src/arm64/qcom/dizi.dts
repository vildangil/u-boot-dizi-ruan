/*
 * Device Tree Source for Xiaomi Redmi Pad Pro (dizi)
 */

/dts-v1/;

#include "sm7435.dtsi"

/ {
	model = "Xiaomi Redmi Pad Pro";
	compatible = "xiaomi,dizi", "qcom,sm7435";

	chosen {
		/* Указываем U-Boot, куда выводить консоль */
		stdout-path = &{/soc@0/geniqup@9c0000/serial@998000};
	};

	/* Заглушка для памяти, чтобы U-Boot мог загрузиться */
	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x40000000>; /* 1GB, нужно будет уточнить */
	};
};
